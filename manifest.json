{
  "manifest_version": 3,
  "name": "Human Type Paste",
  "version": "1.0.0",
  "description": "Paste text into a field by typing like a human — with adjustable speed and occasional typos.",
  "permissions": ["storage", "activeTab", "scripting", "webNavigation"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Human Type Paste",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "commands": {
    "start-typing": {
      "suggested_key": {
        "default": "Alt+Shift+Period",
        "mac": "Alt+Shift+Period"
      },
      "description": "Start human typing into the selected field"
    },
    "stop-typing": {
      "suggested_key": {
        "default": "Alt+Shift+Comma",
        "mac": "Alt+Shift+Comma"
      },
      "description": "Stop human typing"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
